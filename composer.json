{
	"name": "updatronix/updatronix",
	"description": "",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Quentin Le Duff",
			"email": "quentin@holdmywp.com"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "v3.64.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"squizlabs/php_codesniffer": "^3.11",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2"
	},
	"scripts": {
		"lint:php": [
			"vendor/bin/php-cs-fixer fix -v --show-progress=dots --using-cache=no --config=.config/.php-cs-fixer.php tests",
			"vendor/bin/phpstan analyse --memory-limit=2048M --configuration=.config/phpstan.neon updatronix.php inc"
		],
        "lint:wpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist",
        "format:wpcs": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
        "verify:php": [
            "@format:wpcs",
            "@lint:wpcs",
            "@lint:php",
            "@test"
        ],
        "verify:all": [
            "@format:wpcs",
            "@lint:wpcs",
            "@lint:php",
            "@test",
            "@test:integration"
        ],
        "test": "phpunit --configuration=.config/phpunit.xml.dist",
        "test:integration": "bash .config/local-wp-cli.sh integration-test",
        "test:all": [
            "@test",
            "@test:integration"
        ],
        "lint:pcp": "bash .config/local-wp-cli.sh pcp",
        "make:pot": "bash .config/local-wp-cli.sh pot",
        "setup": "bash bin/setup-dev.sh"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
