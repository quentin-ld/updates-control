{
	"name": "updatronix/updatronix",
	"description": "",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "--Q--",
			"email": "quentin@holdmywp.com"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"squizlabs/php_codesniffer": "^3.11",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"lint:wpcs": "vendor/bin/phpcs --standard=.config/phpcs.xml",
		"lint:wpcs:fix": "vendor/bin/phpcbf --standard=.config/phpcs.xml",
		"lint:php": [
			"@lint:wpcs",
			"vendor/bin/phpstan analyse --memory-limit=2048M --configuration=.config/phpstan.neon updatronix.php uninstall.php inc"
		],
        "verify:php": [
            "@lint:php",
            "@test"
        ],
        "verify:all": [
            "@lint:php",
            "@test",
            "@test:integration"
        ],
        "test": "phpunit --configuration=.config/phpunit.xml.dist",
        "test:coverage": "bash .config/local-wp-cli.sh coverage unit",
        "test:coverage:integration": "bash .config/local-wp-cli.sh coverage integration",
        "coverage:check": "bash bin/check-coverage.sh build/coverage/unit.txt ${COVERAGE_THRESHOLD:-10}",
        "test:integration": "bash .config/local-wp-cli.sh integration-test",
        "test:all": [
            "@test",
            "@test:integration"
        ],
        "lint:pcp": "bash .config/local-wp-cli.sh pcp",
        "make:pot": "bash .config/local-wp-cli.sh pot",
        "setup": "bash bin/setup-dev.sh"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
