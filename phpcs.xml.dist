<?xml version="1.0"?>
<ruleset name="Updatronix">
	<description>WordPress Coding Standards ruleset for the Updatronix plugin.</description>

	<file>updatronix.php</file>
	<file>inc</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/.config/*</exclude-pattern>
	<exclude-pattern>*/assets/build/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra">
		<!-- File/class naming: inc/classes/ deliberately uses PascalCase file names, one class per file. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs">
		<!--
		Docblocks intentionally use PHPStan-style generic array-shape types (e.g. `list<string>`,
		`\WP_REST_Request<array<string, mixed>>`) for phpstan-wordpress static analysis precision.
		This sniff doesn't parse that syntax and would otherwise flag every one of them as an error
		asking to downgrade to the bare `array`/`\WP_REST_Request` type, which would reduce the
		precision PHPStan relies on.
		-->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.2"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="updatronix"/>
			</property>
		</properties>
	</rule>
</ruleset>
