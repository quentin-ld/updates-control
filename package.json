{
	"name": "updatronix",
	"description": "",
	"type": "wordpress-plugin",
	"main": "assets/build/index.js",
	"scripts": {
		"lint": "wp-scripts lint-js --config .config/eslint.config.mjs assets/src/**/*.js",
		"lint:fix": "wp-scripts lint-js --config .config/eslint.config.mjs assets/src/**/*.js --fix",
		"lint:css": "wp-scripts lint-style --config .config/stylelintrc.json 'assets/src/**/*.scss'",
		"lint:css:fix": "wp-scripts lint-style --config .config/stylelintrc.json 'assets/src/**/*.scss' --fix",
		"format": "wp-scripts format 'assets/src/**/*.{js,jsx}'",
		"format:fix": "wp-scripts format 'assets/src/**/*.{js,jsx}' --write",
		"start": "wp-scripts start assets/src/index.js --output-path=assets/build",
		"build": "wp-scripts build assets/src/index.js --output-path=assets/build",
		"setup": "bash bin/setup-dev.sh",
		"test:all": "composer run verify:all && composer run lint:pcp && npm run lint && npm run lint:css && npm run format",
		"build:all": "npm run test:all && composer run make:pot && npm run build",
		"zip": "node .config/zip.js"
	},
	"prettier": "@wordpress/prettier-config",
	"author": "Quentin Le Duff",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@wordpress/eslint-plugin": "^25.9.0",
		"@wordpress/prettier-config": "^4.53.0",
		"@wordpress/scripts": "^34.1.0",
		"@wordpress/stylelint-config": "^24.2.0",
		"archiver": "^8.0.0",
		"prettier": "npm:wp-prettier@^3.0.3",
		"typescript": "~5.9.3"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/data": "^10.53.0",
		"@wordpress/dataviews": "^18.0.0",
		"@wordpress/dom-ready": "^4.53.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/icons": "^15.4.0",
		"@wordpress/notices": "^5.53.0",
		"@wordpress/ui": "^0.20.0"
	}
}
